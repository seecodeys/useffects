# IB Gateway / IBC (gnzsnz/ib-gateway). Fill in locally, chmod 600, never commit.
TWS_USERID=
TWS_PASSWORD=
TRADING_MODE=paper
READ_ONLY_API=no
TIME_ZONE=America/New_York
AUTO_RESTART_TIME=11:45 PM
SAVE_TWS_SETTINGS=yes
TWS_SETTINGS_PATH=/home/ibgateway/tws_settings
EXISTING_SESSION_DETECTED_ACTION=primary
TWOFA_TIMEOUT_ACTION=restart
VNC_SERVER_PASSWORD=
